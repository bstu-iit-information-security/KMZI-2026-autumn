[ ca ]
default_ca = CA_default
[ CA_default ]
dir              = /private/tmp/claude-501/-Users-gleb-Desktop-KMZI-2026-autumn/0eef014e-cc3e-483b-b923-71fa8236e99b/scratchpad/v7/inter
database         = $dir/index.txt

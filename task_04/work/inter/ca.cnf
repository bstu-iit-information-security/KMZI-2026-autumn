[ ca ]
default_ca = CA_default
[ CA_default ]
dir              = /Users/gleb/Desktop/KMZI-2026-autumn/task_04/work/inter
database         = $dir/index.txt
new_certs_dir    = $dir
serial           = $dir/serial
